{
  "name": "pr-linter-action",
  "version": "0.2.0",
  "description": "A GitHub action that enforces conventional commit spec on pull requests to ensure a clean commit history.",
  "author": "Gavin Astur",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:gavinastur/pr-linter-action.git"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/lint": "21.2.2",
    "@commitlint/load": "21.2.2",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "main": "src/main/index.ts",
  "scripts": {
    "build": "npm run tsc",
    "dev": "tsx src/main/index.ts",
    "start": "tsx src/main/index.ts",
    "lint": "npm run biome:check:fix",
    "lint:ci": "npm run biome:check",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check --write .",
    "pretty": "biome format --write .",
    "prettier:ci": "npm run pretty",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --silent --coverage",
    "tsc": "tsc"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
