{
  "name": "pr-linter-action",
  "version": "0.2.0",
  "description": "A GitHub action that enforces conventional commit spec on pull requests to ensure a clean commit history.",
  "author": "Gavin Astur",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:gavinastur/pr-linter-action.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/lint": "20.5.0",
    "@commitlint/load": "20.5.0",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "4.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "@actions/core": "3.0.0",
    "@actions/github": "9.0.0",
    "undici": "7.24.5"
  },
  "main": "lib/main/index.js",
  "scripts": {
    "build": "npm run tsc",
    "dev": "ts-node src/main/index.ts",
    "lint": "npm run biome:check:fix",
    "lint:ci": "npm run biome:check",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check --write .",
    "pretty": "biome format --write .",
    "prettier:ci": "npm run pretty",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --silent --coverage",
    "tsc": "tsc"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  }
}
