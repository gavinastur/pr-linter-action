{
  "name": "pr-linter-action",
  "version": "0.0.0-semantically-released",
  "description": "A GitHub action that enforces conventional commit spec on pull requests to ensure a clean commit history.",
  "author": "Gavin Astur",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:gavinastur/pr-linter-action.git"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/types": "21.2.3",
    "conventional-changelog-conventionalcommits": "10.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "rolldown": "1.2.16",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "main": "dist/index.mjs",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "tsx src/main/index.ts",
    "start": "node dist/index.mjs",
    "lint": "npm run biome:check:fix",
    "lint:ci": "npm run biome:check",
    "biome:check": "biome check .",
    "biome:check:fix": "biome check --write .",
    "pretty": "biome format --write .",
    "prettier:ci": "npm run pretty",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --silent --coverage",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": "^26.0.0",
    "npm": "^11.0.0"
  }
}
