{
  "timezone": "Europe/London",
  "schedule": ["after 5pm every weekday", "before 8am every weekday"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    "group:linters",
    "group:test",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "matchDatasources": ["*"],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchUpdateTypes": ["bump", "digest", "lockFileMaintenance", "minor", "patch", "pin"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "rangeStrategy": "pin",
      "matchPackageNames": ["*"]
    },
    {
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Keep Node.js on 24, the runtime GitHub runs this action on (runs.using: node24 in action.yml). Raise both together.",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    }
  ],
  "branchPrefix": "rv8/",
  "hashedBranchLength": null,
  "labels": ["renovate"],
  "dependencyDashboard": {
    "osvVulnerabilitySummary": "all"
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "enabled": true
  }
}
